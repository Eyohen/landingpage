# Analytics IDs. Set these in Netlify's environment variables (or a local .env)
# to enable tracking. Leave blank and no analytics load at all.
VITE_GA4_ID=
VITE_CLARITY_ID=
# Optional endpoint that receives sales-form submissions as JSON POSTs
# (Talk to Sales, Contact Us, Request Crypto Checkout). When unset, forms
# fall back to a prefilled mailto: to info@stablezact.com.
VITE_FORMS_ENDPOINT=
