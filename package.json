{
  "name": "stablezact-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "vite-node scripts/prerender.ts && vite-node scripts/generate-sitemap.ts && vite-node scripts/generate-rss.ts && vite-node scripts/assert-prerendered.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "vite-node scripts/fetch-content.ts"
  },
  "dependencies": {
    "@payloadcms/richtext-lexical": "^3.88.0",
    "highlight.js": "^11.12.0",
    "lenis": "^1.3.24",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}